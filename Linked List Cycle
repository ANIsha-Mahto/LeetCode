public class Solution {
    public boolean hasCycle(ListNode head) {

        //SLOW FAST POINTER
        ListNode slow=head;
        ListNode fast=head;
        while(fast!=null && fast.next!=null){
            slow=slow.next;
            fast=fast.next.next;
            if(slow==fast) return true;
        }
        return false;

