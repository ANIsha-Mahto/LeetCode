class Solution {
    public int numberOfSubstrings(String s) {
        int n=s.length();
        int cnt=0;
        int []last={-1,-1,-1};
        for(int j=0;j<n;j++){
                last[s.charAt(j)-'a']=j;
                if(last[0]!=-1 &&last[1]!=-1 && last[2]!=-1 ){
                    cnt=cnt+(1+Math.min(last[0],Math.min(last[1],last[2])));
                }
        }
        
        return cnt;


