class Solution {
    public int fib(int n) {
        Scanner sc=new Scanner(System.in);
        // if(n<=1) return n;
        // return fib(n-1)+fib(n-2);

        if(n==0) return 0;
        if(n==1) return 1;
        int a=0;
        int b=1;
        for(int i=2;i<=n;i++){
           // System.out.print(a+" ");
            int next=a+b;
            a=b;
            b=next;
        }
        return b;
    }
}
