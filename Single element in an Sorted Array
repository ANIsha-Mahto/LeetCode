class Solution {
    public int singleNonDuplicate(int[] nums) {
        int n=nums.length;
        //BS
        int left=0;
        int right=n-1;
        while(left<right){
            int mid=(left+right)/2;
            if(mid%2==1){
                mid--;
            }
            if(nums[mid]==nums[mid+1]){
                left=mid+2;
            }
            else{
                right=mid;
            }
        }
        return nums[left];


