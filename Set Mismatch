class Solution {
    public int[] findErrorNums(int[] nums) {
        int n=nums.length;
        int duplicate=-1;
        Arrays.sort(nums);

        for(int i=0;i<=n-1;i++){
            if(nums[i]==nums[i+1]){
                 duplicate=nums[i];
                 break;
            }
        }            
        
        int xor=0;
        for(int i=0;i<=n;i++)
           xor^=i;
        for(int num:nums)
           xor^=num;
        int miss=xor^duplicate;
        return new int[]{duplicate,miss};
    }
}
