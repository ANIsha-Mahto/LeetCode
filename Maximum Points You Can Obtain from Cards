class Solution {
    public int maxScore(int[] cardPoints, int k) {
        int n=cardPoints.length;
        int sum=0;
        for(int j=0;j<k;j++){
            sum+=cardPoints[j];
        }
        int max=sum;
        int left=k-1;
        int right=n-1;
        while(left>=0){
            sum+=cardPoints[right];
            sum-=cardPoints[left];
            left--;
            right--;
        
            max=Math.max(max,sum);
        }
        
        return max;   
    }
}
