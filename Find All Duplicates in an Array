class Solution {
    public List<Integer> findDuplicates(int[] nums) {
        int n=nums.length;
        //O(nlogn)
        // Arrays.sort(nums);
        // List<Integer>ans=new ArrayList<>();
        // for(int i=0;i<n-1;i++){
        //     if(nums[i]==nums[i+1]){
        //         ans.add(nums[i]);
        //     }  
        // }
        // return ans;


        //O(n)
        List<Integer>ans=new ArrayList<>();
        for(int i=0;i<nums.length;i++){
            int idx=Math.abs(nums[i])-1;
            if(nums[idx]<0)
               ans.add(idx+1);
            else
               nums[idx]=-nums[idx];
               
        }
        return ans;
    }
}
