class Solution {
    public boolean isIsomorphic(String s, String t) {
        if(s.length()!=t.length()){
            return false;
        }
        int []st=new int[256];
        int []ts=new int[256];
        for(int i=0;i<s.length();i++){
            char c1=s.charAt(i);
            char c2=t.charAt(i);
            if(st[c1]!=0 && st[c1]!=c2)
               return false;
            if(ts[c2]!=0 && ts[c2]!=c1)
                return false;
            st[c1]=c2;
            ts[c2]=c1;
        }
        return true;

    }
}
