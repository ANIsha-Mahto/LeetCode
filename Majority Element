class Solution {
    public int majorityElement(int[] nums) {
        // Arrays.sort(nums);
        // return nums[nums.length/2];

        int count=0;
        int ele=0;
        for(int num:nums){
            if(count==0){
                ele=num;

            }
            if(num==ele){
                count++;
            }else{
                count--;
            }
        }
        return ele;
    }
}
