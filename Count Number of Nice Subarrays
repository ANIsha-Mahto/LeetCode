class Solution {
    public int numberOfSubarrays(int[] nums, int k) {
        int n=nums.length;
        int ans=0;
        int l1=0,l2=0;
        int sum1=0,sum2=0;
        for(int i=0;i<n;i++){
            sum1+=(nums[i]%2);
            sum2+=(nums[i]%2);
            while(sum1>k){
                sum1=sum1-(nums[l1]%2);
                l1=l1+1;
            }
            while(sum2>k-1){
                sum2=sum2-(nums[l2]%2);
                l2=l2+1;
            }
            ans+=l2-l1;
        }
        return ans;



