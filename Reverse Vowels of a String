class Solution {
    public String reverseVowels(String s) {
        char []ch=s.toCharArray();
        int p1=0;
        int p2=s.length()-1;
        while(p1<p2){
            while(p1<p2 && !reverseVowels(ch[p1])){
                p1++;
            }
            while(p1<p2 && !reverseVowels(ch[p2])){
                p2--;

            }
            char temp=ch[p1];
            ch[p1]=ch[p2];
            ch[p2]=temp;
            p1++;
            p2--;
        }
        return new String(ch);
    }
    public boolean reverseVowels(char ch){
            return "aeiouAEIOU".indexOf(ch)!=-1;
    }
        
    
}
