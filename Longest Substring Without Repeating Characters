class Solution {
    public int lengthOfLongestSubstring(String s) {
        int n=s.length();
        int []idx=new int[128];
        Arrays.fill(idx,-1);
        int i=0,j=0;
        int max=0;
        while(j<n){
            char ch=s.charAt(j);
            if(idx[ch]>=i){
                i=idx[ch]+1;
            }
            idx[ch]=j;
            max=Math.max(max,j-i+1);
            j++;
        }
        return max;


